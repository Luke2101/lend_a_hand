{
  "name": "api",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "test": "vitest run --reporter verbose",
    "dev": "nodemon dist/src/server.js",
    "db:applyChanges": "npx drizzle-kit generate && npx drizzle-kit migrate",
    "db:push": "npx drizzle-kit push",
    "db:gen": "npx @better-auth/cli generate --output ./src/db/auth-schema.ts",
    "db:setup": "npm run db:gen && npm run db:applyChanges",
    "setup": "npm install && npx tsc && npm rum db:setup",
    "compile": "tsc",
    "db:generateSampleData": "node dist/src/sample.js",
    "firstTimeSetup": "npm run setup && npm run db:generateSampleData",
    "start": "node dist/src/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@faker-js/faker": "^10.1.0",
    "@types/supertest": "^6.0.3",
    "better-auth": "^1.3.27",
    "chalk": "^5.6.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.6",
    "express": "^5.1.0",
    "http-status-codes": "^2.3.0",
    "mysql2": "^3.15.3",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.2",
    "supertest": "^7.1.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.12"
  },
  "type": "module",
  "devDependencies": {
    "@testcontainers/mysql": "^11.7.2",
    "@tsconfig/node22": "^22.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^3.2.4",
    "drizzle-kit": "^0.31.5",
    "mocha": "^11.7.4",
    "nodemon": "^3.1.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
